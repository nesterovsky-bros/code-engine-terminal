API_KEY_ID=replace-with-your-ibm-cloud-api-key
CE_REGION=replace-with-your-region
RESOURCE_GROUP=replace-with-your-resource-group
CE_PROJECT_ID=replace-with-your-code-engine-project-id

# Optional settings
# CE_APP=terminal
# REGISTRY_SECRET=replace-with-your-private-registry-secret
# Placeholders resolve in the disk mapping: $USER and $EMAIL use trusted gateway
# headers (EMAIL uses the complete email), and $TERMINAL_ID uses the generated
# job ID.
# DATA_STORE=store-name:root/$USER/$EMAIL/$TERMINAL_ID
# TERMINAL_ENV_HEADER_PREFIX=x-terminal-
# PORT=8080
